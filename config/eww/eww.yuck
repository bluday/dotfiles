(include "./presets/material-design-3/widgets/bottom-bar/main.yuck")
(include "./presets/material-design-3/widgets/power-menu/main.yuck")

(defwindow bottom-bar-0
    :exclusive true
    :geometry
        (geometry
            :x "0%"
            :y "0%"
            :width "100%"
            :height "32px"
            :anchor "bottom center")
    :monitor 0
    :stacking "fg"
    :windowtype "dock"
    :wm-ignore false
    (bottom-bar))

(defwindow power-menu-0
    :exclusive true
    :geometry
        (geometry
            :x "0%"
            :y "0%"
            :width "100%"
            :height "100%"
            :anchor "top left")
    :monitor 0
    :stacking "fg"
    :windowtype "normal"
    :wm-ignore false
    (power-menu))
