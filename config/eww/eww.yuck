(include "./widgets/bottom-bar/main.yuck")

(defwindow bottom-bar-0
    :exclusive true
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "100%"
                        :height "32px"
                        :anchor "bottom center")
    :monitor 0
    :stacking "fg"
    :windowtype "dock"
    :wm-ignore false
    (bottom-bar))
