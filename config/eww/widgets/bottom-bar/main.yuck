(include "./widgets/bottom-bar/datetime.yuck")

(defwidget bottom-bar []
    (box :class "bottom-bar"
         :halign "fill"
         :orientation "h"
        (box :halign "start"
             :orientation "h"
             "1")
        (box :halign "center"
             :orientation "h"
             (datetime))
        (box :halign "end"
             :orientation "h"
             (systray :icon-size 18
                      :orientation "h"
                      :prepend-new true
                      :spacing 4)
            )
        )
    )
